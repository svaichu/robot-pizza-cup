# Copy to elrobot/elrobot.env and fill in after identifying the buses
# in the Station web UI (http://localhost:8889).
#
# From elrobot: cp elrobot.env.example elrobot.env

# USB controller serials. Each bus should show 8 servos.
LEADER_SERIAL=
FOLLOWER_SERIAL=

# Station host. localhost when the server runs on this laptop.
STATION_HOST=localhost

# Stored on every exported frame. Use the same words at train and deploy.
TASK="place pepperoni on pizza"

# dataset-generator -episode.duration (seconds).
EPISODE_DURATION=45

# Path prefix. export writes ${DATASET_OUTPUT}.parquet (+ .mp4 preview).
# Relative paths are resolved from elrobot/. Default lands in repo-root data/.
DATASET_OUTPUT=../data/elrobot-pizza

export STATION_DATA_DIR=/mnt/external/station_data

